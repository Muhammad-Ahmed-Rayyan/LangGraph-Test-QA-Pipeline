    "blocked": "Project could not install or boot. No tests were written or run. Fix setup_errors.",
    "execution_failed": "Tests were written but the test run itself crashed (e.g. database unreachable). Not a code fault in the tests.",
    "tests_failed": "Tests ran and some failed. Fix the code behind each entry in faults.",
    "tests_passed": "Tests ran and all passed. Nothing to fix."
  },
